<Application x:Class="Rewind.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#111820" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1A242F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A6B7C7" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="#D0F278" />
            <Setter Property="Foreground" Value="#142015" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
